rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['userId', 'displayName', 'email', 'createdAt']) &&
        data.keys().hasOnly(['userId', 'displayName', 'email', 'photoURL', 'createdAt', 'lastLoginAt']) &&
        data.userId == request.auth.uid &&
        data.userId is string && data.userId.size() <= 128 &&
        data.displayName is string && data.displayName.size() <= 100 &&
        data.email is string && data.email.size() <= 150 &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000)) &&
        data.createdAt is string && data.createdAt.size() <= 50;
    }

    function isValidSavedNode(data) {
      return data.keys().hasAll(['userId', 'nodeId', 'title', 'sector']) &&
        data.keys().hasOnly(['userId', 'nodeId', 'title', 'sector', 'summary', 'createdAt']) &&
        data.userId == request.auth.uid &&
        data.userId is string && data.userId.size() <= 128 &&
        data.nodeId is string && data.nodeId.size() <= 128 &&
        data.title is string && data.title.size() <= 200 &&
        data.sector is string && data.sector.size() <= 50 &&
        (!('summary' in data) || (data.summary is string && data.summary.size() <= 2000)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50));
    }

    function isValidUserSpatialNode(data) {
      return data.keys().hasAll(['userId', 'nodeId', 'title', 'sector']) &&
        data.keys().hasOnly(['userId', 'nodeId', 'code', 'title', 'sector', 'category', 'summary', 'details', 'source', 'status', 'r', 'theta', 'phi', 'createdAt']) &&
        data.userId == request.auth.uid &&
        data.userId is string && data.userId.size() <= 128 &&
        data.nodeId is string && data.nodeId.size() <= 128 &&
        data.title is string && data.title.size() <= 200 &&
        data.sector is string && data.sector.size() <= 50 &&
        (!('summary' in data) || (data.summary is string && data.summary.size() <= 2000)) &&
        (!('details' in data) || (data.details is string && data.details.size() <= 10000)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50));
    }

    function isValidViewedNode(data) {
      return data.keys().hasAll(['userId', 'nodeId', 'viewedAt']) &&
        data.keys().hasOnly(['userId', 'nodeId', 'viewedAt']) &&
        data.userId == request.auth.uid &&
        data.userId is string && data.userId.size() <= 128 &&
        data.nodeId is string && data.nodeId.size() <= 128 &&
        data.viewedAt is string && data.viewedAt.size() <= 50;
    }

    function isValidSearchHistory(data) {
      return data.keys().hasAll(['userId', 'query', 'searchedAt']) &&
        data.keys().hasOnly(['userId', 'query', 'searchedAt']) &&
        data.userId == request.auth.uid &&
        data.userId is string && data.userId.size() <= 128 &&
        data.query is string && data.query.size() <= 500 &&
        data.searchedAt is string && data.searchedAt.size() <= 50;
    }

    function isValidMemoriaLog(data) {
      return data.keys().hasAll(['userId', 'lessonId', 'title', 'loggedAt']) &&
        data.keys().hasOnly(['userId', 'lessonId', 'title', 'takeaway', 'category', 'actionPlan', 'loggedAt']) &&
        data.userId == request.auth.uid &&
        data.userId is string && data.userId.size() <= 128 &&
        data.lessonId is string && data.lessonId.size() <= 128 &&
        data.title is string && data.title.size() <= 200 &&
        (!('takeaway' in data) || (data.takeaway is string && data.takeaway.size() <= 2000)) &&
        (!('actionPlan' in data) || (data.actionPlan is string && data.actionPlan.size() <= 2000)) &&
        data.loggedAt is string && data.loggedAt.size() <= 50;
    }

    function isValidChatMessage(data) {
      return data.keys().hasAll(['userId', 'role', 'text', 'timestamp']) &&
        data.keys().hasOnly(['userId', 'role', 'text', 'modelName', 'timestamp', 'sources', 'grounding']) &&
        data.userId == request.auth.uid &&
        data.userId is string && data.userId.size() <= 128 &&
        data.role in ['user', 'model'] &&
        data.text is string && data.text.size() <= 50000 &&
        (!('modelName' in data) || (data.modelName is string && data.modelName.size() <= 100)) &&
        data.timestamp is string && data.timestamp.size() <= 50;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidUserProfile(incoming()) && incoming().userId == existing().userId;
      allow delete: if isOwner(userId);

      match /saved_nodes/{nodeDocId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidSavedNode(incoming());
        allow update: if isOwner(userId) && isValidSavedNode(incoming()) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId);
      }

      match /user_nodes/{nodeDocId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidUserSpatialNode(incoming());
        allow update: if isOwner(userId) && isValidUserSpatialNode(incoming()) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId);
      }

      match /viewed_nodes/{nodeDocId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidViewedNode(incoming());
        allow update: if isOwner(userId) && isValidViewedNode(incoming()) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId);
      }

      match /search_history/{historyDocId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidSearchHistory(incoming());
        allow update: if isOwner(userId) && isValidSearchHistory(incoming()) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId);
      }

      match /memoria_logs/{lessonDocId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidMemoriaLog(incoming());
        allow update: if isOwner(userId) && isValidMemoriaLog(incoming()) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId);
      }

      match /chat_messages/{messageId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidChatMessage(incoming());
        allow update: if isOwner(userId) && isValidChatMessage(incoming()) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId);
      }
    }
  }
}
